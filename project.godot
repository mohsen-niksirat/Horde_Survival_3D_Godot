; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="HordeSurvival 3D"
config/description="A stylized third-person survival roguelite. Survive the horde, auto-attack, level up, evolve weapons."
run/main_scene="res://scenes/bootstrap/Boot.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.101961, 0.109804, 0.14902, 1)
boot_splash/show_image=false
config/icon="res://assets/ui/icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
RunManager="*res://scripts/core/run_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"
InputManager="*res://scripts/input/input_manager.gd"
PoolManager="*res://scripts/utilities/pool_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
PerformanceManager="*res://scripts/performance/performance_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

